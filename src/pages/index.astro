---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Nacer Benallou">
  <div class="prose">
    <h1 style="font-size: var(--text-4xl); margin-bottom: var(--sp-4);">Nacer Benallou</h1>
    <p style="font-size: var(--text-lg); color: var(--color-text-muted); margin-bottom: var(--sp-12);">
      Writing on Product Management, Fintech and Market Making.
    </p>

    <section style="margin-bottom: var(--sp-12);">
      <h2 style="font-size: var(--text-xl); margin-bottom: var(--sp-6);">Recent posts</h2>
      <ul style="list-style: none; display: flex; flex-direction: column; gap: var(--sp-4);">
        <li>
          <a href="/blog/foreign-exchange-liberalisation-in-morocco">Foreign exchange liberalisation in Morocco</a>
          <span style="display: block; font-size: var(--text-sm); color: var(--color-text-muted);">Market making</span>
        </li>
        <li>
          <a href="/blog/fostering-an-experimentation-culture-within-product-teams">Fostering an experimentation culture within Product teams</a>
          <span style="display: block; font-size: var(--text-sm); color: var(--color-text-muted);">Causal inference</span>
        </li>
      </ul>
    </section>

    <section>
      <h2 style="font-size: var(--text-xl); margin-bottom: var(--sp-6);">Projects</h2>
      <p><a href="/projects">See all projects →</a></p>
    </section>
  </div>
</Layout>
