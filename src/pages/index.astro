---
import Layout from "../layouts/Layout.astro";
import PostList from "../components/PostList.astro";
import { posts } from "../data/posts";
---

<Layout title="Nacer Benallou">
  <header class="hero">
    <h1>Writing on Product Management, Fintech and Market Making.</h1>
    <p>Notes and essays at the intersection of markets, product, and data — with the math worked out, not hand-waved.</p>
  </header>

  <section>
    <div class="section-label">Recent posts</div>
    <PostList posts={posts} />
  </section>

  <section style="margin-top: var(--sp-12);">
    <div class="section-label">Projects</div>
    <p><a href="/projects" style="font-family: var(--font-mono); font-size: var(--text-base);">See all projects →</a></p>
  </section>
</Layout>
