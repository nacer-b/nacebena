---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Projects — Nacer Benallou" description="Projects by Nacer Benallou.">
  <div class="prose">
    <h1 style="font-size: var(--text-4xl); margin-bottom: var(--sp-4);">Projects</h1>
    <p style="color: var(--color-text-muted); margin-bottom: var(--sp-12);">
      Things I've built.
    </p>

    <ul style="list-style: none; display: flex; flex-direction: column; gap: var(--sp-8);">
      <li>
        <p style="font-size: var(--text-xl); font-weight: 600; color: var(--color-text);">FXMM</p>
        <p style="margin-top: var(--sp-2); color: var(--color-text-muted);">
          FX market making simulator — coming in v2.
        </p>
      </li>
      <li>
        <p style="font-size: var(--text-xl); font-weight: 600; color: var(--color-text);">Personal Finance for Couples</p>
        <p style="margin-top: var(--sp-2); color: var(--color-text-muted);">
          Shared budgeting and financial planning — coming in v2.
        </p>
      </li>
    </ul>
  </div>
</Layout>
